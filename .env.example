# ===== Telegram =====
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your chat id (talk to @userinfobot to get it, or run: python tools_get_chat_id.py)
TELEGRAM_CHAT_ID=

# ===== Scan settings =====
# How often to scan, in minutes
SCAN_INTERVAL_MINUTES=15

# Comma-separated tickers (Yahoo Finance symbols).
# Indices: ^GSPC = S&P 500, ^IXIC = Nasdaq Composite, ^NDX = Nasdaq 100
# Crypto:  BTC-USD, ETH-USD
WATCHLIST=^GSPC,^IXIC,BTC-USD,ETH-USD

# Candle interval and lookback used for analysis
BAR_INTERVAL=15m
LOOKBACK_PERIOD=60d

# ===== Indicator thresholds =====
RSI_PERIOD=14
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ATR_PERIOD=14

# Risk/reward: stop distance = ATR * ATR_STOP_MULT, targets are multiples of risk
ATR_STOP_MULT=1.5
TARGET1_R=1.5
TARGET2_R=3.0

# Enable news sentiment analysis (true/false)
USE_SENTIMENT=true

# Only send a fresh alert for the same symbol+direction at most once per N minutes
ALERT_COOLDOWN_MINUTES=120
